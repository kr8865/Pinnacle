NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb://127.0.0.1:27017/pinnacle_tuition

JWT_ACCESS_SECRET=replace_with_strong_random_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace_with_another_strong_random_secret
JWT_REFRESH_EXPIRES_DAYS=30
JWT_REFRESH_EXPIRES_DAYS_SHORT=1

SEED_ADMIN_EMAIL=admin@pinnacletuition.com
SEED_ADMIN_PASSWORD=change_this_password

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Pinnacle Tuition Classes <no-reply@pinnacletuition.com>"

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=200
